# ─────────────────────────────────────────────────────────────────────────────
# RYU — copy to .env and fill in. Keys never leave your machine (BYOK).
# Minimum to run everything: GOOGLE_API_KEY + the three LIVEKIT_* values.
# ─────────────────────────────────────────────────────────────────────────────

# Brain + voice + fallback transcription. Free: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Voice link (Converse mode). Either:
#   a) local:  run `livekit-server --dev` (v1.12+) → the defaults below work as-is
#   b) cloud:  free project at https://cloud.livekit.io → paste its URL/key/secret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Optional upgrades (each improves one slot) ──────────────────────────────
# Faster live draft transcript (free tier ≈ 8 h audio/day): https://console.groq.com
GROQ_API_KEY=
# Best final transcript + speaker labels ($50 free credit ≈ 200 h): https://www.assemblyai.com
ASSEMBLYAI_API_KEY=

# ── Advanced (defaults are fine) ────────────────────────────────────────────
# RYU_LLM_MODEL=gemini-flash-latest
# RYU_LLM_LITE_MODEL=gemini-flash-lite-latest
# RYU_LIVE_MODEL=gemini-3.8-live
# RYU_LIVE_VOICE=Charon
# RYU_SERVER_PORT=8787
# The app finds the server at http://localhost:8787 by default. On a phone, put
# EXPO_PUBLIC_RYU_SERVER_URL=http://<your-LAN-IP>:8787 in apps/app/.env (Expo reads env from there).
