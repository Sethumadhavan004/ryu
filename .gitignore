# dependencies
node_modules/

# env & secrets — keys live only in your local .env (BYOK)
.env
.env.*
!.env.example

# expo / build output
.expo/
dist/
web-build/
apps/app/ios/
apps/app/android/
*.tsbuildinfo

# leftovers from the pre-V1 Next.js app that may still sit in old checkouts
