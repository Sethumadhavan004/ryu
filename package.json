{
  "name": "ryu",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,agent,app -c blue,magenta,cyan \"npm:dev -w @ryu/server\" \"npm:agent -w @ryu/server\" \"npm:web -w @ryu/app\"",
    "dev:demo": "npm run web -w @ryu/app",
    "doctor": "npm run doctor -w @ryu/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
