{
  "expo": {
    "name": "Ryu",
    "slug": "ryu",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#02050C",
    "splash": { "backgroundColor": "#02050C" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.ryu.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ryu listens for your voice commands and records meetings you start.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "dev.ryu.app",
      "adaptiveIcon": {
        "backgroundColor": "#02050C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS", "android.permission.FOREGROUND_SERVICE", "android.permission.FOREGROUND_SERVICE_MICROPHONE"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Ryu",
      "backgroundColor": "#02050C",
      "themeColor": "#02050C"
    },
    "plugins": [
      "expo-font",
      ["expo-audio", { "microphonePermission": "Ryu listens for your voice commands and records meetings you start.", "enableBackgroundRecording": true }],
      "expo-sqlite",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ]
  }
}
